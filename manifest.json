{
  "manifest_version": 3,
  "name": "Little Helium",
  "version": "1.0.0",
  "description": "Arc-style Little windows for Helium: links from other apps open in a small, minimal window you can promote to a full window with one key.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "New Little Window",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "storage",
    "contextMenus",
    "scripting",
    "search",
    "system.display"
  ],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "open-little-window": {
      "suggested_key": { "default": "Alt+Shift+N", "mac": "Alt+Shift+N" },
      "description": "Open a new Little window"
    },
    "promote-little-window": {
      "suggested_key": { "default": "Alt+Shift+O", "mac": "Alt+Shift+O" },
      "description": "Move the Little window's page into a main window"
    },
    "pop-out-tab": {
      "description": "Pop the current tab out into a Little window"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["link-click.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
